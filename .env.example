# Copy to .env and edit if needed. Every setting is optional (defaults work).
# All variables use the DOCUSENSE_ prefix.

# Trained model files (download from Kaggle, see KAGGLE_TRAINING.md)
DOCUSENSE_CLASSIFIER_CKPT=models/checkpoints/classifier_v1.pth
DOCUSENSE_TAGGER_CKPT=models/checkpoints/tagger_v1.pth
DOCUSENSE_DEVICE=cpu

# Windows: full paths if Tesseract / Poppler are not on PATH
# DOCUSENSE_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# DOCUSENSE_POPPLER_PATH=C:\tools\poppler\Library\bin

# Storage / limits
DOCUSENSE_DATABASE_URL=sqlite:///docusense.db
DOCUSENSE_UPLOAD_DIR=uploads
DOCUSENSE_MAX_FILE_SIZE_MB=20

# Fields below this confidence are flagged for review
DOCUSENSE_REVIEW_CONF_THRESHOLD=0.70
